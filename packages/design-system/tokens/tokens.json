{
  "$comment": "Source of truth for the aiBytes_ app + Chrome extension. The newsletter is deliberately NOT a consumer - see CLAUDE.md.",
  "brand": {
    "paper":  "#FAFAF7",
    "ink":    "#191C26",
    "cobalt": "#2B4EF0",
    "signal": "#FFD338",
    "slate":  "#6B7080",
    "line":   "#E4E4DC",
    "card":   "#FFFFFF"
  },
  "palette": {
    "cobalt-hover":  "#213EC7",
    "cobalt-active": "#1A32A0",
    "ink-raised":    "#222634",
    "ink-line":      "#333848",
    "slate-light":   "#9AA0B0",
    "danger-base":   "#C6301E",
    "success-base":  "#127A52"
  },
  "semantic": {
    "light": {
      "surface":         "{brand.paper}",
      "surface-raised":  "{brand.card}",
      "text":            "{brand.ink}",
      "text-muted":      "{brand.slate}",
      "border":          "{brand.line}",
      "accent":          "{brand.cobalt}",
      "accent-hover":    "{palette.cobalt-hover}",
      "accent-active":   "{palette.cobalt-active}",
      "accent-on":       "#FFFFFF",
      "highlight":       "{brand.signal}",
      "danger":          "{palette.danger-base}",
      "success":         "{palette.success-base}"
    },
    "dark": {
      "surface":         "{brand.ink}",
      "surface-raised":  "{palette.ink-raised}",
      "text":            "{brand.paper}",
      "text-muted":      "{palette.slate-light}",
      "border":          "{palette.ink-line}",
      "accent":          "#6B85FF",
      "accent-hover":    "#8397FF",
      "accent-active":   "#5570F5",
      "accent-on":       "{brand.ink}",
      "highlight":       "{brand.signal}",
      "danger":          "#F0705C",
      "success":         "#3FBE8E"
    }
  },
  "font": {
    "display": "'Bricolage Grotesque', system-ui, Helvetica, Arial, sans-serif",
    "body":    "'Instrument Sans', system-ui, Helvetica, Arial, sans-serif",
    "mono":    "'JetBrains Mono', ui-monospace, Menlo, Consolas, monospace"
  },
  "text": {
    "xs":  "12px",
    "sm":  "13px",
    "md":  "15px",
    "lg":  "18px",
    "xl":  "24px",
    "2xl": "32px"
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px"
  },
  "radius": {
    "sm":   "4px",
    "md":   "8px",
    "lg":   "14px",
    "full": "999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(25,28,38,.08)",
    "md": "0 6px 20px rgba(25,28,38,.12)"
  }
}
