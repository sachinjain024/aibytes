{
  "name": "aibytes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:web": "npm run dev -w @aibytes/web",
    "build:web": "npm run build -w @aibytes/web",
    "dev:extension": "npm run dev -w @aibytes/extension",
    "package:extension": "npm run package -w @aibytes/extension",
    "preview:design-system": "npm run preview -w @aibytes/design-system",
    "validate:content": "python3 packages/feed-schema/validate.py"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  }
}
