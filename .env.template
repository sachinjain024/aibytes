# Copy to .env at the repo root and fill in. .env is git-ignored; this file is
# not, so it must never hold a real value. Write values bare - no quotes.

# ProductHunt developer token, from https://www.producthunt.com/v2/oauth/applications.
# Used directly as the Bearer token. Read by packages/fetchers (producthunt).
PH_API_KEY=

# Only for OAuth client credentials. When set, PH_API_KEY is treated as the
# client id and the pair is exchanged for an access token. Leave unset to use
# a developer token.
# PH_API_SECRET=

# Slack incoming webhook for the daily runner's success and failure messages.
# A bearer credential: anyone holding it can post into the workspace. Unset
# means the run still happens and logs, it just reports to nobody.
# Test it with: python3 packages/runner/notify.py
AIBYTES_SLACK_WEBHOOK=

# Not read from here: ANTHROPIC_API_KEY is only a GitHub Actions secret, for
# the edition.yml fallback. Locally, Claude Code uses the login keychain.
